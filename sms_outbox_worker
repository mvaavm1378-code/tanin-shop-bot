# -*- coding: utf-8 -*-
"""
Hardened manual worker for verified transactional wallet/cashback SMS notices.
Important:
- Sends only to a phone with phone_verified_at set.
- Claims queued rows as 'sending' and commits BEFORE contacting provider.
- A network timeout leaves status='sending' for manual reconciliation, rather
  than automatically retrying an SMS that may already have been accepted.
- Provider success requires Melipayamak's JSON RetStatus == 1.
Run only during your sender line's permitted hours.
"""
import os
import asyncio
import json
import logging
from datetime import datetime, time
from zoneinfo import ZoneInfo

import aiohttp
import psycopg
from psycopg.rows import dict_row

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")

DB_URL = (os.getenv("SUPABASE_DB_URL") or os.getenv("DATABASE_URL") or "").strip()
USERNAME = os.getenv("MELIPAYAMAK_USERNAME", "").strip()
PASSWORD = (
    os.getenv("MELIPAYAMAK_API_KEY")
    or os.getenv("MELIPAYAMAK_PASSWORD")
    or ""
).strip()
SENDER = os.getenv("MELIPAYAMAK_SENDER", "").strip()
SMS_URL = "https://rest.payamak-panel.com/api/SendSMS/SendSMS"
TEHRAN = ZoneInfo("Asia/Tehran")
BATCH_SIZE = 10


def permitted_hours():
    now = datetime.now(TEHRAN).time()
    return time(8, 0) <= now < time(20, 0)


def parse_provider_response(body):
    """Return (accepted, provider_id, description); fail closed on unknown formats."""
    try:
        data = json.loads(body)
    except (TypeError, json.JSONDecodeError):
        return False, None, "Unrecognized non-JSON provider response"

    if not isinstance(data, dict):
        return False, None, "Unrecognized provider response shape"

    ret_status = data.get("RetStatus")
    provider_id = data.get("Value")
    description = str(data.get("StrRetStatus") or data.get("Message") or "")[:500]

    # Melipayamak REST SendSMS success status is RetStatus == 1.
    if str(ret_status).strip() == "1":
        return True, str(provider_id)[:200] if provider_id is not None else None, description

    return False, None, description or f"Provider rejected message (RetStatus={ret_status!r})"


async def claim_batch(conn):
    """Atomically mark a small batch as sending before any external request."""
    async with conn.transaction():
        rows = await (await conn.execute(
            """
            SELECT id
            FROM public.sms_outbox
            WHERE status = 'queued'
              AND message_category IN ('cashback_notice','wallet_adjustment_notice','wallet_payment_notice')
            ORDER BY queued_at, id
            FOR UPDATE SKIP LOCKED
            LIMIT %s
            """,
            (BATCH_SIZE,),
        )).fetchall()

        ids = [row["id"] for row in rows]
        if ids:
            await conn.execute(
                """
                UPDATE public.sms_outbox
                SET status = 'sending',
                    attempts = attempts + 1,
                    updated_at = NOW(),
                    last_error = NULL
                WHERE id = ANY(%s)
                """,
                (ids,),
            )
    return ids


async def process_one(conn, session, outbox_id):
    row = await (await conn.execute(
        """
        SELECT o.id, o.loyalty_customer_id, o.destination_phone, o.message_text,
               lc.phone_e164, lc.phone_verified_at,
               COALESCE(scp.transactional_sms_enabled, FALSE) AS sms_enabled
        FROM public.sms_outbox o
        LEFT JOIN public.loyalty_customers lc ON lc.id = o.loyalty_customer_id
        LEFT JOIN public.sms_customer_preferences scp
               ON scp.loyalty_customer_id = o.loyalty_customer_id
        WHERE o.id = %s AND o.status = 'sending'
        """,
        (outbox_id,),
    )).fetchone()

    if not row:
        return

    phone = (row["phone_e164"] or "").strip()
    if not phone or not row["phone_verified_at"] or not row["sms_enabled"]:
        await conn.execute(
            """
            UPDATE public.sms_outbox
            SET status='cancelled', last_error=%s, updated_at=NOW()
            WHERE id=%s AND status='sending'
            """,
            ("No verified phone or transactional SMS disabled", outbox_id),
        )
        await conn.commit()
        return

    # Use the current verified number, not a stale destination copied into the queue.
    payload = {
        "username": USERNAME,
        "password": PASSWORD,
        "to": phone,
        "from": SENDER,
        "text": row["message_text"],
        "isFlash": False,
    }

    try:
        async with session.post(SMS_URL, data=payload) as response:
            body = (await response.text())[:1000]
            http_status = response.status
    except (aiohttp.ClientError, asyncio.TimeoutError) as exc:
        # Delivery is ambiguous: provider may have accepted before the timeout.
        # Keep status='sending' to prevent automatic duplicate sends.
        await conn.execute(
            """
            UPDATE public.sms_outbox
            SET last_error=%s, updated_at=NOW()
            WHERE id=%s AND status='sending'
            """,
            (f"Delivery outcome uncertain; manual reconciliation required: {type(exc).__name__}", outbox_id),
        )
        await conn.commit()
        logging.warning("SMS outbox id=%s has uncertain delivery; not retrying automatically.", outbox_id)
        return

    if http_status != 200:
        await conn.execute(
            """
            UPDATE public.sms_outbox
            SET status='failed', last_error=%s, updated_at=NOW()
            WHERE id=%s AND status='sending'
            """,
            (f"Provider HTTP status {http_status}: {body}", outbox_id),
        )
        await conn.commit()
        return

    accepted, provider_id, description = parse_provider_response(body)
    if accepted:
        await conn.execute(
            """
            UPDATE public.sms_outbox
            SET status='accepted', provider_message_id=%s,
                sent_at=NOW(), updated_at=NOW(), last_error=NULL
            WHERE id=%s AND status='sending'
            """,
            (provider_id, outbox_id),
        )
    else:
        await conn.execute(
            """
            UPDATE public.sms_outbox
            SET status='failed', last_error=%s, updated_at=NOW()
            WHERE id=%s AND status='sending'
            """,
            (f"Provider did not confirm acceptance: {description}; response={body}"[:1000], outbox_id),
        )
    await conn.commit()


async def main():
    missing = []
    if not DB_URL:
        missing.append("SUPABASE_DB_URL/DATABASE_URL")
    if not USERNAME:
        missing.append("MELIPAYAMAK_USERNAME")
    if not PASSWORD:
        missing.append("MELIPAYAMAK_API_KEY/MELIPAYAMAK_PASSWORD")
    if not SENDER:
        missing.append("MELIPAYAMAK_SENDER")
    if missing:
        raise SystemExit("Missing required environment variables: " + ", ".join(missing))
    if not permitted_hours():
        raise SystemExit("Worker stopped: permitted sending window is 08:00-20:00 Asia/Tehran.")

    async with await psycopg.AsyncConnection.connect(DB_URL, row_factory=dict_row) as conn:
        ids = await claim_batch(conn)
        if not ids:
            logging.info("No queued cashback notices.")
            return

        timeout = aiohttp.ClientTimeout(total=20)
        async with aiohttp.ClientSession(timeout=timeout) as session:
            for outbox_id in ids:
                try:
                    await process_one(conn, session, outbox_id)
                except Exception:
                    # Do not put a possibly-sent message back in the queue.
                    await conn.execute(
                        """
                        UPDATE public.sms_outbox
                        SET last_error='Unexpected worker error; manual reconciliation required',
                            updated_at=NOW()
                        WHERE id=%s AND status='sending'
                        """,
                        (outbox_id,),
                    )
                    await conn.commit()
                    logging.exception("Worker error for outbox id=%s; left in sending state.", outbox_id)

        logging.info("Claimed and processed %s cashback notice(s).", len(ids))


if __name__ == "__main__":
    asyncio.run(main())
